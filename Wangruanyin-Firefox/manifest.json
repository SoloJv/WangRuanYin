{
  "manifest_version": 3,
  "name": "网软音 - Wangruanyin (Firefox)",
  "description": "Annota la pagina con pinyin e traduzione. Mozilla Firefox compatible build.",
  "version": "0.4.0",

  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_title": "网软音",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "pinyin-dict-characters.js",
        "pinyin-data.js",
        "hsk2-char-levels.js",
        "hsk3-char-levels.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "wangruanyin@example.com",
      "strict_min_version": "115.0"
    }
  }
}