{
  "manifest_version": 3,
  "name": "网软音 - Wangruanyin",
  "description": "Annota la pagina con pinyin e traduzione. Safari compatible build.",
  "version": "0.4.0",

  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_title": "Wangruanyin",
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "pinyin-dict-characters.js",
        "pinyin-data.js",
        "hsk2-char-levels.js",
        "hsk3-char-levels.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "14.0"
    }
  }
}